# Node owns all Spotify tokens; we ask it for catalog facts.
NODE_SERVICE_URL=http://127.0.0.1:3000

# MusicBrainz REQUIRES a descriptive User-Agent with contact info.
# Requests without one get blocked. Put a real address here.
MUSICBRAINZ_USER_AGENT=classic-wrapped/0.1 ( you@example.com )

# Where streaming history JSON lands, and where MB responses are cached.
DATA_DIR=../data
CACHE_DIR=../cache
